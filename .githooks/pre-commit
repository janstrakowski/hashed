#!/usr/bin/env sh
# docs/repo-files.json is the playground's filesystem: the repository, 1:1.
# Every tracked file is in it, so *any* commit can make it stale - including
# commits that only touch a test script. Regenerating here means the check in
# CI (build_playground_files.mjs --check) is a backstop rather than a chore.
#
# Enable with: git config core.hooksPath .githooks
set -e
command -v node >/dev/null || exit 0   # no node, no manifest to regenerate

node scripts/build_playground_files.mjs >/dev/null
if ! git diff --quiet -- docs/repo-files.json; then
  git add docs/repo-files.json
  echo "pre-commit: refreshed docs/repo-files.json"
fi
